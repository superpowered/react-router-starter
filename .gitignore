##############################
# ASH WordPress .gitignore
# Version: 1.0.0
##############################

# WordPress will be handled via package.json
api/wp-admin
api/wp-includes
api/wp-*.php
api/xmlrpc.php
api/index.php
api/license.txt
api/readme.html
api/readme.*.html

# Include wp-config, since it will be handled via env vars
!wp-config.php

# Ships with WordPress Stuff
api/wp-content/themes/twenty*
api/wp-content/plugins/hello.php
api/wp-content/upgrade
api/wp-content/tmp
api/wp-content/blogs.dir

# Ignore Uploads
api/wp-content/uploads

# Backup Plugin Stuff
api/wp-content/backup
api/wp-content/backups
api/wp-content/backup-db
api/wp-content/backup-db/*
api/wp-content/backup*
api/wp-content/updraft
api/wp-content/managewp
wp-snapshots
api/wp-content/ai1wm-backups

#Eshop
api/wp-content/eshop_downloads

# Duplicator stuff
api/web.config
api/web.config.*
api/wp-tests-config.php

# Wordfence Stuff
api/wordfence-waf.php
api/wp-content/wflogs
api/wp-content/wfcache
api/wp-content/plugins/wordfence/tmp

# Cache stuff
api/wp-content/advanced-cache.php
api/wp-content/wp-cache-config.php
api/wp-content/w3tc-config
api/wp-content/db.php
api/wp-content/object-cache.php
api/wp-content/object-cache.php.*
api/wp-content/cache
api/wp-content/cache/*
api/wp-content/cache/supercache/*
api/wp-content/plugins/bwp-minify/cache
api/wp-content/et-cache
api/wp-content/wp-rocket-config

# Webmaster Verification Stuff
google*.html
yandex_*.html

# Server Config stuff
/nginx.conf
/php.ini
.user.ini

# Server folders
error
stats
cgi-bin
nbproject
temp

# Build Stuff
node_modules

# Lint Caches
.eslintcache
.stylelintcache
.phplint-cache

# Enviroment Stuff
.env
.env.pi

# Log stuff:
sitemap.*
*.log
*.sql
*.sqlite
*.sass-cache
error_log
logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Forwards / Aliases / Subdomains:
/forwards
/aliases
/subdomains

# Hidden files:
/.htaccess
/.htaccess*
/.htaccess.*
*[Tt]humbs.db
ehthumbs.db
*.Trashes
*.sass-cache*
*~imageoptim*
.idea
.idea/*
.ftpquota
.well-known/
.well-known
.maintenance
~*
.svn
.cvs
*.bak
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.sw?

# Composer
/vendor

# Generated dev files:
*.css.map
*.js.map

# Package files:
# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# large/disallowed file types
# a CDN should be used for these
*.hqx
*.bin
*.exe
*.dll
*.deb
*.dmg
*.iso
*.img
*.msi
*.msp
*.msm
*.mid
*.midi
*.kar
*.mp3
*.ogg
*.m4a
*.ra
*.3gpp
*.3gp
*.mp4
*.mpeg
*.mpg
*.mov
*.webm
*.flv
*.m4v
*.mng
*.asx
*.asf
*.wmv
*.avi

# IDE Folders / Files
.vscode/*
!.vscode/extensions.json
*.code-workspace
*.sublime-project
*.sublime-workspace
*.komodoproject

# OSX Specific
__MACOSX
.AppleDouble
.LSOverride
*.DS_Store

# WPEngine Specific
.smushit-status
.gitattributes
_wpeprivate*
api/wp-content/mu-plugins/mu-plugin.php
api/wp-content/mu-plugins/slt-force-strong-passwords.php
api/wp-content/mu-plugins/stop-long-comments.php
api/wp-content/mu-plugins/force-strong-passwords*
api/wp-content/mu-plugins/wpengine-common*
api/wp-content/mysql.sql
api/wp-content/mu-plugins/wpengine-security-auditor.php
api/wp-content/mu-plugins/wpe-wp-sign-on-plugin*

# Composer and Guzzle Specific
vendor

# Local Environment: ddev
wp-config-ddev.php
.ddev

# React Router
/.react-router/
/build/

# Build stuff
dist
**/dist/*
dist-ssr
**/dist-ssr/*
*.local