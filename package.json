{
  "name": "starter",
  "type": "module",
  "version": "1.0.0",
  "description": "Starter",
  "author": "Andrew Herder",
  "license": "All Rights Reserved",
  "private": true,
  "config": {
    "wpVersion": "6.9.1"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "wp:remove": "bash ./scripts/rm-wordpress-script.sh",
    "wp:install": "bash ./scripts/install-wordpress-script.sh $npm_package_config_wpVersion",
    "pi:build": "react-router build --mode pi",
    "pi:deploy": "bash ./scripts/deploy-pi-script.sh",
    "pi:build:deploy": "yarn run pi:build && yarn run pi:deploy",
    "postinstall": "yarn run wp:install"
  },
  "engineStrict": true,
  "engines": {
    "node": ">=24",
    "yarn": ">=1.22"
  },
  "dependencies": {
    "@linaria/core": "^7.0.0",
    "@linaria/react": "^7.0.1",
    "@react-router/node": "7.12.0",
    "@react-router/serve": "7.12.0",
    "@wyw-in-js/babel-preset": "^1.0.6",
    "isbot": "^5.1.31",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "7.12.0"
  },
  "devDependencies": {
    "@react-router/dev": "7.12.0",
    "@types/node": "^22",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@wyw-in-js/vite": "^1.0.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
